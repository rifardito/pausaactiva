---
import Icon from "./Icon.astro";
import TextSizeToggle from "./TextSizeToggle.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();

const links = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#nosotras", label: "Nosotras" },
  { href: "/#donde", label: "Dónde estamos" },
  { href: "/#contacto", label: "Contacto" },
];
---

<footer class="bg-[#1f2f0c] text-cream/80">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2">
      <a
        href="/"
        class="flex items-center gap-3 text-cream no-underline"
        aria-label="Pausa Activa · Ir al inicio"
      >
        <img
          src="/img/logo.png"
          alt=""
          width="44"
          height="44"
          class="h-11 w-11"
          loading="lazy"
        />
        <span class="text-[1.3rem] leading-none font-bold">Pausa Activa</span>
      </a>
      <p class="mt-4 max-w-sm text-[1rem] leading-snug">
        {site.claim}.
      </p>
    </div>

    <nav aria-label="Navegación del pie">
      <h2 class="text-[0.85rem] font-bold tracking-[0.16em] uppercase">
        Navegación
      </h2>
      <ul class="mt-3 space-y-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block py-2 text-[1rem] text-cream/80 no-underline hover:text-cream"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-[0.85rem] font-bold tracking-[0.16em] uppercase">
        Información
      </h2>
      <ul class="mt-3 space-y-2">
        <li>
          <a
            href="/aviso-legal"
            class="inline-block py-2 text-[1rem] text-cream/80 no-underline hover:text-cream"
          >
            Aviso legal
          </a>
        </li>
        <li>
          <a
            href="/privacidad"
            class="inline-block py-2 text-[1rem] text-cream/80 no-underline hover:text-cream"
          >
            Política de privacidad
          </a>
        </li>
      </ul>

      <div class="mt-5 flex gap-3">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/25 text-cream hover:bg-cream/10"
          aria-label="Pausa Activa en Instagram"
        >
          <Icon name="instagram" size={20} />
        </a>
        <a
          href={site.facebook}
          target="_blank"
          rel="noopener"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/25 text-cream hover:bg-cream/10"
          aria-label="Pausa Activa en Facebook"
        >
          <Icon name="facebook" size={20} />
        </a>
      </div>

      <div class="mt-6 md:hidden">
        <p class="text-[0.85rem] font-bold tracking-[0.16em] uppercase">
          Tamaño del texto
        </p>
        <TextSizeToggle tone="dark" class="mt-2" />
      </div>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div
      class="container-page flex flex-col gap-2 py-5 pb-24 text-[0.9rem] sm:flex-row sm:items-center sm:justify-between md:pb-5"
    >
      <p>© {year} Pausa Activa · Logroño (La Rioja)</p>
      <p>Hecho con cariño en La Rioja.</p>
    </div>
  </div>
</footer>
