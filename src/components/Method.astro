---
const steps = [
  {
    title: "Escuchar y conocer",
    text: "Tus preferencias, capacidades, entorno y necesidades.",
  },
  {
    title: "Crear un plan individualizado",
    text: "Adaptado a ti y coordinado con los profesionales que ya te atienden.",
  },
  {
    title: "Poner en marcha",
    text: "Actuamos según el plan acordado, a tu ritmo.",
  },
  {
    title: "Evaluar y ajustar",
    text: "Revisión continua y pautas para seguir por tu cuenta.",
  },
];
---

<section id="metodo" class="section border-y border-olive/10 bg-cream-soft">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 class="section-title mt-4">Un plan pensado para ti.</h2>
      <p class="mt-5 text-[1.1rem] leading-relaxed text-sage-deep">
        Intervenciones individuales y grupales, adaptadas a cada persona.
      </p>
    </div>

    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="relative rounded-[1.5rem] border border-olive/10 bg-cream p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-olive text-[1.05rem] font-bold text-cream">
              {index + 1}
            </span>
            <h3 class="mt-4 text-[1.15rem] leading-tight">{step.title}</h3>
            <p class="mt-2 text-[1rem] leading-snug text-sage-deep">
              {step.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
