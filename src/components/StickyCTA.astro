---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-olive/15 bg-cream/95 px-3 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md md:hidden"
>
  <div class="grid grid-cols-2 gap-3">
    <a href={site.phoneHref} class="btn btn-primary">
      <Icon name="phone" size={20} />
      Llamar
    </a>
    <a
      href={site.whatsappHref}
      class="btn btn-wa"
      target="_blank"
      rel="noopener"
    >
      <Icon name="whatsapp" size={20} />
      WhatsApp
    </a>
  </div>
</div>
