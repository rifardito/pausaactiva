---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<section id="contacto" class="bg-olive-deep py-16 text-cream sm:py-24">
  <div class="container-page grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <p class="eyebrow text-peach">Contacto</p>
      <h2 class="section-title mt-4">Hablemos.</h2>
      <p class="mt-4 max-w-lg text-[1.1rem] leading-relaxed text-cream/85">
        Cuéntanos qué necesitas y te explicamos cómo podemos ayudarte, sin
        compromiso.
      </p>

      <a
        href={site.phoneHref}
        class="mt-8 inline-flex items-center gap-4 text-cream no-underline"
      >
        <span
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-peach text-olive"
        >
          <Icon name="phone" size={26} />
        </span>
        <span>
          <span class="block text-[0.8rem] font-bold tracking-[0.16em] uppercase">
            Llámanos
          </span>
          <span class="block text-[clamp(2rem,6vw,2.9rem)] leading-none font-bold">
            {site.phoneLabel}
          </span>
        </span>
      </a>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.whatsappHref}
          class="btn btn-wa"
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={22} />
          WhatsApp
        </a>
        <a
          href={site.emailHref}
          class="btn border-2 border-cream/30 text-cream hover:bg-cream/10"
        >
          <Icon name="mail" size={22} />
          Escríbenos un correo
        </a>
      </div>

      <p class="mt-5 flex items-center gap-2 text-[1rem] text-cream/75">
        <Icon name="clock" size={18} />
        Teléfono de 9:00 a 20:00 · Oficina de 9:00 a 15:00
      </p>
    </div>

    <div class="rounded-[1.75rem] border border-cream/15 bg-cream/5 p-6 sm:p-8">
      <h3 class="text-[1.25rem]">Estamos cerca</h3>

      <ul class="mt-5 space-y-5">
        <li class="flex items-start gap-3">
          <Icon name="map-pin" size={22} class="mt-0.5 shrink-0 text-peach" />
          <p class="text-[1rem] leading-snug">
            {site.street}<br />{site.city}
          </p>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="mail" size={22} class="mt-0.5 shrink-0 text-peach" />
          <a
            href={site.emailHref}
            class="inline-block py-1 text-[1rem] leading-snug break-all text-cream underline decoration-cream/40 underline-offset-4 hover:decoration-cream"
          >
            {site.email}
          </a>
        </li>
      </ul>

      <hr class="my-6 border-cream/15" />

      <p class="text-[0.85rem] font-bold tracking-[0.16em] uppercase">
        Síguenos
      </p>
      <div class="mt-3 flex gap-3">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-cream/25 text-cream hover:bg-cream/10"
          aria-label="Pausa Activa en Instagram"
        >
          <Icon name="instagram" size={22} />
        </a>
        <a
          href={site.facebook}
          target="_blank"
          rel="noopener"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-cream/25 text-cream hover:bg-cream/10"
          aria-label="Pausa Activa en Facebook"
        >
          <Icon name="facebook" size={22} />
        </a>
      </div>
    </div>
  </div>
</section>
