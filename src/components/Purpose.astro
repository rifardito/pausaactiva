---
import Icon from "./Icon.astro";

const pillars = [
  {
    icon: "shield",
    title: "Prevenir",
    text: "Mantener capacidades y detectar necesidades a tiempo.",
  },
  {
    icon: "users",
    title: "Conectar y sensibilizar",
    text: "Crear vínculos, participación y relaciones significativas.",
  },
  {
    icon: "home",
    title: "Facilitar",
    text: "Acercar apoyos para la vida cotidiana y el domicilio.",
  },
];
---

<section id="proposito" class="section">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Nuestro propósito</p>
      <h2 class="section-title mt-4">Autonomía, dignidad y calidad de vida.</h2>
      <p class="mt-5 text-[1.1rem] leading-relaxed text-sage-deep">
        Favorecer que las personas mayores permanezcan en su hogar el mayor
        tiempo posible, con bienestar, participación social y los apoyos
        adecuados.
      </p>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-3">
      {
        pillars.map((pillar, index) => (
          <li class="rounded-[1.5rem] border border-olive/10 bg-cream-soft p-6">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-olive text-peach">
              <Icon name={pillar.icon} size={26} />
            </span>
            <p class="mt-5 text-[0.85rem] font-bold tracking-[0.14em] text-sage-deep">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-1 text-[1.25rem] leading-tight">{pillar.title}</h3>
            <p class="mt-2 text-[1rem] leading-snug text-sage-deep">
              {pillar.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
