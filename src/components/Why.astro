---
const needs = [
  {
    title: "Soledad no deseada",
    text: "Aislamiento social y falta de compañía en el día a día.",
  },
  {
    title: "Pérdida de autonomía",
    text: "O riesgo de perderla por falta de acción y participación.",
  },
  {
    title: "Acompañamiento",
    text: "Necesidad de bienestar y apoyo en la vida cotidiana.",
  },
  {
    title: "Apoyos accesibles",
    text: "Para poder seguir viviendo en tu propio hogar.",
  },
];
---

<section id="por-que" class="section border-y border-olive/10 bg-cream-soft">
  <div class="container-page grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div>
      <p class="eyebrow">Por qué nace Pausa Activa</p>
      <h2 class="section-title mt-4">Queremos anticiparnos, no llegar tarde.</h2>

      <blockquote
        class="mt-8 border-l-4 border-peach pl-5 text-[1.15rem] leading-relaxed text-sage-deep italic"
      >
        «Envejecer no significa dejar de decidir, disfrutar ni formar parte
        activa de la comunidad.»
      </blockquote>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        needs.map((need, index) => (
          <li class="rounded-2xl border border-olive/10 bg-cream p-5">
            <p class="text-[0.85rem] font-bold tracking-[0.14em] text-sage-deep">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-1 text-[1.1rem] leading-tight">{need.title}</h3>
            <p class="mt-1.5 text-[1rem] leading-snug text-sage-deep">
              {need.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
