---
import Icon from "./Icon.astro";

const lines = [
  {
    n: "01",
    name: "Línea Estimula",
    icon: "sparkles",
    intro: "Prevenir la pérdida de capacidades físicas y cognitivas.",
    services: [
      {
        icon: "sparkles",
        name: "Estimulación cognitiva",
        text: "Sesiones individuales, a domicilio o en nuestro espacio, adaptadas a tus necesidades.",
        prices: ["30 € a domicilio", "25 € en el espacio", "Pack 100 €/mes"],
      },
      {
        icon: "activity",
        name: "Mantenimiento físico",
        text: "Con profesional especializado en fisioterapia.",
        prices: ["40 € / sesión"],
      },
    ],
  },
  {
    n: "02",
    name: "Línea Bienestar",
    icon: "users",
    intro: "Prevenir la soledad no deseada y cuidar lo sociocultural.",
    services: [
      {
        icon: "users",
        name: "Talleres y actividades grupales",
        text: "En nuestro espacio y en colaboración con instituciones y recursos de Logroño. Temáticas: soledad no deseada, duelo, dinámicas familiares, arte, danza y grupos de conversación.",
        prices: ["Desde 10 €"],
      },
    ],
    highlight: "La mayoría de las actividades son gratuitas.",
  },
  {
    n: "03",
    name: "Línea Acompaña",
    icon: "heart",
    intro: "Facilitar y asistir las actividades de la vida cotidiana.",
    services: [
      {
        icon: "utensils",
        name: "Comida a domicilio",
        text: "Puntual, semanal o mensual. Casera, de KM0 y cocina tradicional.",
        prices: ["De 12 € a 15 €"],
      },
      {
        icon: "clipboard",
        name: "Recados, gestiones y acompañamiento",
        text: "Al médico, al banco o a cualquier trámite.",
        prices: ["15 € / hora", "+20 € a más de 15 km"],
      },
      {
        icon: "scissors",
        name: "Peluquería, podología y reparaciones",
        text: "Te lo facilitamos en casa.",
        prices: ["Según necesidad"],
      },
    ],
  },
];
---

<section id="servicios" class="section">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Qué hacemos</p>
      <h2 class="section-title mt-4">Tres líneas, un mismo objetivo.</h2>
      <p class="mt-5 text-[1.1rem] leading-relaxed text-sage-deep">
        Prevención, vínculos y apoyos cotidianos. Elige lo que necesitas: puedes
        empezar por una línea y combinarlas cuando quieras.
      </p>
    </div>

    <ul class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        lines.map((line) => (
          <li class="flex flex-col rounded-[1.75rem] border border-olive/10 bg-cream-soft p-6 sm:p-7">
            <div class="flex items-center gap-3">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-peach text-olive">
                <Icon name={line.icon} size={24} />
              </span>
              <div>
                <p class="text-[0.78rem] font-bold tracking-[0.16em] text-sage-deep uppercase">
                  Línea {line.n}
                </p>
                <h3 class="text-[1.4rem] leading-tight">{line.name}</h3>
              </div>
            </div>

            <p class="mt-4 text-[1rem] leading-snug text-sage-deep italic">
              {line.intro}
            </p>

            <ul class="mt-5 space-y-5">
              {line.services.map((service) => (
                <li>
                  <h4 class="flex items-start gap-2 text-[1.0625rem] leading-snug font-bold">
                    <Icon
                      name={service.icon}
                      size={18}
                      class="mt-0.5 shrink-0 text-sage-deep"
                    />
                    {service.name}
                  </h4>
                  <p class="mt-1.5 text-[1rem] leading-snug text-sage-deep">
                    {service.text}
                  </p>
                  <ul class="mt-2.5 flex flex-wrap gap-2">
                    {service.prices.map((price) => (
                      <li class="rounded-full bg-peach/45 px-3 py-1 text-[0.95rem] font-bold">
                        {price}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>

            {line.highlight && (
              <p class="mt-5 rounded-xl bg-sage/20 px-4 py-3 text-[0.95rem] leading-snug font-bold text-sage-deep">
                {line.highlight}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-[0.95rem] text-sage-deep">
      Precios orientativos. Llámanos y te lo explicamos sin compromiso.
    </p>
  </div>
</section>
