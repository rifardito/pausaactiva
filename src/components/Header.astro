---
import Icon from "./Icon.astro";
import TextSizeToggle from "./TextSizeToggle.astro";
import { site } from "../data/site";

const nav = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#nosotras", label: "Nosotras" },
  { href: "/#donde", label: "Dónde estamos" },
  { href: "/#contacto", label: "Contacto" },
];
---

<header
  class="sticky top-0 z-50 border-b border-olive/10 bg-cream/95 backdrop-blur-md"
>
  <div class="container-page flex items-center justify-between gap-3 py-3">
    <a
      href="/"
      class="flex items-center gap-3 no-underline"
      aria-label="Pausa Activa · Ir al inicio"
    >
      <img
        src="/img/logo.png"
        alt=""
        width="44"
        height="44"
        class="h-11 w-11 shrink-0"
      />
      <span class="text-[1.3rem] leading-none font-bold tracking-tight text-olive">
        Pausa Activa
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <TextSizeToggle class="hidden md:flex" />
      <a href={site.phoneHref} class="btn btn-primary px-4 text-[1rem]">
        <Icon name="phone" size={20} />
        <span class="hidden sm:inline">{site.phoneLabel}</span>
        <span class="sm:hidden">Llamar</span>
      </a>
    </div>
  </div>
</header>
