---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Lines from "../components/Lines.astro";
import Why from "../components/Why.astro";
import Purpose from "../components/Purpose.astro";
import Method from "../components/Method.astro";
import About from "../components/About.astro";
import Location from "../components/Location.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";
---

<Base
  title="Pausa Activa | Acompañamiento para personas mayores en Logroño"
  description="Acompañamiento, estimulación cognitiva y física, talleres y comida a domicilio para personas mayores en Logroño. Trato cercano. Llámanos: 648 17 36 62."
>
  <Header />

  <main id="contenido">
    <Hero />
    <TrustStrip />
    <Lines />
    <Why />
    <Purpose />
    <Method />
    <About />
    <Location />
    <Contact />
  </main>

  <Footer />
  <StickyCTA />
</Base>
